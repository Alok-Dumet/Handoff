{
  "name": "handoff",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test": "node --test scripts/*.test.mjs",
    "test:api": "pnpm --filter @handoff/bff... build && node --test apps/bff/test/*.test.mjs"
  },
  "devDependencies": {
    "turbo": "^2.9.18"
  },
  "engines": {
    "node": ">=20"
  }
}
