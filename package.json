{
  "name": "handoff",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:history": "pnpm --filter @handoff/bff... --filter @handoff/rental... --filter @handoff/notifications... --filter @handoff/identity... build && node scripts/history-browser.mjs",
    "test:compose": "node scripts/compose-browser.mjs",
    "test": "pnpm --filter @handoff/contracts build && node --test scripts/*.test.mjs",
    "test:api": "pnpm --filter @handoff/bff... --filter @handoff/rental... --filter @handoff/identity... build && node --test apps/bff/test/*.test.mjs",
    "test:notifications": "pnpm --filter @handoff/notifications... build && node --test apps/notifications/test/*.test.mjs",
    "test:identity": "pnpm --filter @handoff/identity... build && node --test apps/identity/test/*.test.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "turbo": "^2.9.18"
  },
  "engines": {
    "node": ">=20"
  }
}
