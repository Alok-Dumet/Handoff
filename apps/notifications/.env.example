# Defaults work with the local infrastructure Compose file.
NOTIFICATIONS_DATABASE_URL=postgresql://notifications:notifications@localhost:5433/notifications
NOTIFICATIONS_PORT=3002
NOTIFICATIONS_SERVICE_KEY=handoff-local-notifications-key
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
EMAIL_FROM=HandOff <no-reply@handoff.local>
# Optional external SMTP: set SMTP_USER and SMTP_PASSWORD together.
# Use SMTP_SECURE=true for port 465 or SMTP_REQUIRE_TLS=true for STARTTLS.
# EMAIL_WORKER_ENABLED=false pauses SMTP attempts without rejecting events.
