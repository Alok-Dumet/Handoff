# Optional locally; required in production. Matches infra/docker-compose.yml.
DATABASE_URL=postgresql://handoff:handoff@localhost:5432/refdata
PORT=3001
# Exact browser origin for CSRF checks; use https:// on a public host (Secure cookies).
WEB_ORIGIN=http://localhost:3000

# Internal Notifications service; SMTP settings live in apps/notifications/.env.
NOTIFICATIONS_URL=http://127.0.0.1:3002
NOTIFICATIONS_SERVICE_KEY=handoff-local-notifications-key
# EMAIL_WORKER_ENABLED=false pauses outbox forwarding but still queues bookings.

# Accounts and sessions are owned by Identity.
IDENTITY_URL=http://127.0.0.1:3003
IDENTITY_SERVICE_KEY=handoff-local-identity-key
