# Optional locally; required in production. Matches infra/docker-compose.yml.
DATABASE_URL=postgresql://handoff:handoff@localhost:5432/refdata
PORT=3001
# Exact browser origin for CSRF checks; use https:// on a public host (Secure cookies).
WEB_ORIGIN=http://localhost:3000

# Local captured inbox from infra/docker-compose.yml (no real email delivery).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
EMAIL_FROM=HandOff <no-reply@handoff.local>
# For an external provider, set SMTP_USER and SMTP_PASSWORD together; use
# SMTP_SECURE=true on port 465 or SMTP_REQUIRE_TLS=true for STARTTLS on port 587.
# EMAIL_WORKER_ENABLED=false pauses delivery but still queues new confirmations.
