// Application database schema, owned by the NestJS API.
// The Vehicle model mirrors @handoff/contracts VehicleSchema (the source of truth).
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Transmission {
  automatic
  manual
}

enum VehicleClass {
  economy
  compact
  premium
  suv
}

enum BookingStatus {
  pending
  confirmed
  cancelled
}

model Location {
  id        String    @id
  name      String
  address   String
  latitude  Float
  longitude Float
  vehicles  Vehicle[]

  @@map("locations")
}

model Vehicle {
  id              String       @id
  make            String
  model           String
  year            Int
  class           VehicleClass
  transmission    Transmission
  seats           Int
  pricePerDay     Int
  salePricePerDay Int?
  locationId      String
  location        Location     @relation(fields: [locationId], references: [id])
  bookings        Booking[]

  @@index([locationId])
  @@map("vehicles")
}

model Booking {
  id            String        @id
  vehicleId     String
  customerName  String
  customerEmail String
  startDate     DateTime
  endDate       DateTime
  status        BookingStatus @default(pending)
  createdAt     DateTime      @default(now())
  vehicle       Vehicle       @relation(fields: [vehicleId], references: [id])
  // Older bookings remain unowned; never assign ownership by matching email.
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Purchase-page reservation details. Nullable because bookings created
  // before the purchase flow existed have none, and backfilling invented
  // values would be worse than an honest null.
  pickupLocationId     String?
  dropoffLocationId    String?
  pickupAt             DateTime?
  dropoffAt            DateTime?
  addOnIds             String[]  @default([])
  protectionPlanId     String?
  acceptedTermsVersion String?

  // Server-computed at write time, in integer cents. Stored rather than
  // recomputed on read so the agreed price is fixed at the moment of booking:
  // a later catalog or tax change must not retroactively alter it.
  subtotalCents Int?
  taxCents      Int?
  totalCents    Int?
  requestKey   String?
  requestHash  String?
  checkoutSnapshot Json?

  @@unique([userId, requestKey])
  @@index([vehicleId])
  @@index([userId])
  @@map("bookings")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
  bookings     Booking[]

  @@map("users")
}

model Session {
  tokenHash String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
