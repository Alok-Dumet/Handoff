# Optional overrides for the root Docker Compose stack. Defaults need no .env.
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
DB_PORT=5432
SMTP_PORT=1025
INBOX_PORT=8025
DEMO_INBOX_URL=http://localhost:8025
NOTIFICATIONS_DB_PORT=5433
# Local demo key only. Set a private shared key before public deployment.
NOTIFICATIONS_SERVICE_KEY=handoff-local-notifications-key
